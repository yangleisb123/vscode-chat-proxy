----
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/async/fs",
  "moonbitlang/core/buffer",
}
----

///|
/// Rebuild the monitor frontend (rabbita -> JS) and embed the assets into
/// `web_assets.mbt` so the proxy stays a single self-contained artifact.
/// Run from the module root:  moon run tools/build_web.mbtx
async fn main {
  let code = @shell.Cmd(
    "moon",
    ["build", "frontend", "--target", "js", "--release"],
  ).status()
  if code != 0 {
    println("frontend build failed with exit code \{code}")
    return
  }
  let bundle = @fs.read_file(
    "_build/js/release/build/frontend/frontend.js",
  ).text()
  let shell_html = @fs.read_file("web/index.html").text()
  let out = @buffer.Buffer()
  out.write_string_utf8(
    "///|\n/// Generated by tools/build_web.mbtx - DO NOT EDIT.\n/// Embedded monitor web assets: HTML shell + rabbita frontend bundle.\nlet index_html : String =\n",
  )
  for line in shell_html.split("\n") {
    out.write_string_utf8("  #|")
    out.write_string_utf8(line)
    out.write_string_utf8("\n")
  }
  // Embed the bundle in segments to keep each text block within limits.
  let lines : Array[StringView] = [for l in bundle.split("\n") => l]
  let chunk_size = 1200
  let mut part = 1
  let names : Array[String] = []
  let mut i = 0
  while i < lines.length() {
    let end = if i + chunk_size < lines.length() {
      i + chunk_size
    } else {
      lines.length()
    }
    let name = "frontend_js_part\{part}"
    names.push(name)
    out.write_string_utf8("\n///|\nlet \{name} : String =\n")
    let mut j = i
    while j < end {
      out.write_string_utf8("  #|")
      out.write_string_utf8(lines[j])
      out.write_string_utf8("\n")
      j += 1
    }
    part += 1
    i = end
  }
  out.write_string_utf8("\n///|\nlet frontend_js : String = ")
  out.write_string_utf8(names.join(" + "))
  out.write_string_utf8("\n")
  @fs.write_file("monitor/web_assets.mbt", out.to_bytes(), create_mode=CreateOrTruncate)
  println("monitor/web_assets.mbt generated (\{bundle.length()} chars of JS)")
}