// Facade package: re-exports the layered public API so existing importers
// of `1123Javayanglei/vscode-chat-proxy` keep working.
//
// Layers:
//   shared/            wire contract types (frontend + backend)
//   proxy/             interception + forwarding core
//   monitor/           flow store + monitor web server
//   config/            CLI / env / .env-driven configuration
//   internal/httpparse HTTP parsing helpers (implementation support)
//   internal/dotenv    .env loading (implementation support)

import {
  "1123Javayanglei/vscode-chat-proxy/proxy" @proxy_impl,
  "1123Javayanglei/vscode-chat-proxy/config" @config_impl,
  "1123Javayanglei/vscode-chat-proxy/monitor" @monitor_impl,
  "1123Javayanglei/vscode-chat-proxy/internal/dotenv" @dotenv_impl,
}

supported_targets = "+native+wasm"
