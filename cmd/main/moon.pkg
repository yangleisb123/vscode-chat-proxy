import {
  "1123Javayanglei/vscode-chat-proxy" @proxy,
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/async/socket",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

supported_targets = "+native"

// `@fs` is only used by the non-Windows SO_REUSEPORT probe in main.mbt, so
// Windows checks report the import as unused. Keep it for Linux builds.

warnings = "-unused_package"

pkgtype(kind: "executable")

// glibc < 2.34 keeps pthread/dl outside libc; the runtime (mimalloc, thread
// pool) needs them explicitly. On newer glibc these are harmless stub libraries.

options(
  link: { "native": { "cc-link-flags": "-lpthread -ldl" } },
)
