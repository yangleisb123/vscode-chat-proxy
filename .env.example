# vscode-chat-proxy 用户配置模板
# 复制为 .env 后按需修改：cp .env.example .env
# 优先级：命令行参数 > 真实环境变量 > .env > 默认值
# 已存在的环境变量不会被 .env 覆盖。

# 本地监听地址
HOST=127.0.0.1
PORT=8787

# 上游 HTTP API 服务器（one-api / new-api / sub2api / Ollama 等，明文 HTTP）
# 示例：
#   本地网关:  UPSTREAM_HOST=127.0.0.1  UPSTREAM_PORT=8080
#   Ollama:    UPSTREAM_HOST=127.0.0.1  UPSTREAM_PORT=11434
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8080

# 组合地址写法（可选，优先于上面的 HOST/PORT/UPSTREAM_HOST/UPSTREAM_PORT）
# VSCODE_CHAT_PROXY_LISTEN=0.0.0.0:8787
# VSCODE_CHAT_PROXY_UPSTREAM=127.0.0.1:8080

# 监控页面（mitmweb 风格，查看拦截请求的入参/出参）
# 浏览器打开 http://127.0.0.1:8788 ；命令行 --no-web 可关闭
WEB_HOST=127.0.0.1
WEB_PORT=8788

# 监控数据目录（默认：系统临时目录下 vscode-chat-proxy-monitor-<WEB_PORT>）
# Windows 示例：C:\Users\you\AppData\Local\Temp\vscode-chat-proxy-monitor-8788
# MONITOR_DIR=

# 注入到 /v1/chat/completions 请求里的 system 消息第一句（可自定义）
# 默认值就是下面这句；也可以改成任意话术，或命令行 --system-prompt "…"
# 注意：换行请用引号包裹，值本身也会被去掉首尾空白。
SYSTEM_PROMPT=你是一个AI助手，工作在 vscode 环境中